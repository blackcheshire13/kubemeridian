# Rendered into wrangler.toml by deploy.sh; the inbox address stays out of this public repo.
name = "devopstech-pilot"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = false

routes = [
  { pattern = "devopstech.net/api/pilot", zone_name = "devopstech.net" },
  { pattern = "www.devopstech.net/api/pilot", zone_name = "devopstech.net" },
]

[vars]
TO = "__PILOT_TO__"

# Email Routing: may only send to this verified destination address
[[send_email]]
name = "MAIL"
destination_address = "__PILOT_TO__"

# 5 applications per minute per client IP
[[ratelimits]]
name = "LIMIT"
namespace_id = "1001"
simple = { limit = 5, period = 60 }
